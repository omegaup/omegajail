@include ./gcc.policy

# I/O
copy_file_range: allow
dup3: allow
epoll_create1: allow
epoll_ctl: allow
epoll_pwait: allow
getdents64: allow
fallocate: allow
fchmodat: allow
flock: allow
ftruncate: allow
mkdirat: allow
pwrite64: allow
readlinkat: allow
renameat: allow
unlinkat: allow
utimensat: allow

# Threads
clone: allow
clone3: allow
nanosleep: allow
restart_syscall: allow
rt_sigaction: allow
sched_yield: allow
tgkill: allow

# System
uname: allow
