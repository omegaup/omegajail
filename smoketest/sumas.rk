import rekarel.globals;
class program {
    // Esta función muestra el uso básico de Karel
    void girar180() {
        turnleft();
        turnleft();
        return;
    }

    // Esta función revisa si hay zumbadores y regresa un valor booleano
    bool hayZumbadores() {
        return nextToABeeper();
    }

    program () {
        // toma todos los zumbadores de la celda de la derecha.
        turnleft();
        turnleft();
        turnleft();
        move();
        turnleft();
        while (nextToABeeper()) {
          pickbeeper();
        }

        // deja todos los zumbadores de la mochila
        turnleft();
        move();
        turnleft();
        turnleft();
        turnleft();
        while (anyBeepersInBeeperBag()) {
          putbeeper();
        }

        turnoff();
    }
}
